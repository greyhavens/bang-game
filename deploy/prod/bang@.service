# Bang! Howdy per-town server node — systemd template unit (Epic 3 Phase 6).
#
# One town per instance; the instance name is the node name from server.properties:
#   systemctl enable --now bang@frontier_town
#   systemctl enable --now bang@indian_post
#
# Install: copy to /etc/systemd/system/bang@.service, adjust paths if not using /opt/bang, then
# `systemctl daemon-reload`. Config/secrets come from the EnvironmentFiles below (see the
# *.env.example files next to this unit and docs/runbook.md).
[Unit]
Description=Bang! Howdy server node %i
After=network-online.target
Wants=network-online.target
# if MySQL runs on THIS host (the runbook's default topology is a remote db.internal), also order
# after it: add `After=mysql.service` (and consider `Wants=mysql.service`)

[Service]
Type=exec
User=bang
Group=bang
WorkingDirectory=/opt/bang
# common.env: cluster/DB/TLS secrets shared by all nodes on this host (mode 0600, owned root:bang)
# %i.env: per-node values, e.g. a unique BANG_SERVER_MGMT_PORT when nodes share a host (optional)
EnvironmentFile=/etc/bang/common.env
EnvironmentFile=-/etc/bang/%i.env
# create the writable dirs before the sandbox maps them: ReadWritePaths only remounts EXISTING
# paths, it never creates them — and the launcher itself couldn't mkdir them, because inside the
# strict sandbox /opt is read-only ('+' prefix = run outside the sandbox, as root)
ExecStartPre=+/usr/bin/mkdir -p /opt/bang/log /opt/bang/data/downloads
ExecStartPre=+/usr/bin/chown bang:bang /opt/bang/log /opt/bang/data/downloads
ExecStart=/opt/bang/deploy/prod/run-node.sh %i
Restart=on-failure
RestartSec=5

# BangServer shuts down gracefully on SIGTERM (saves state, closes audit logs); give it time
TimeoutStopSec=60

# basic hardening — strict makes the whole filesystem read-only for the service except the paths
# below (`full` would leave /opt writable and reduce ReadWritePaths to a no-op); the rsrc cache
# goes to /tmp, covered by PrivateTmp. The server's full runtime write surface: audit logs
# (log/) and the soundtrack-download symlinks + stamp files (data/downloads — a live client RPC,
# PlayerManager.createDownloadSymlink).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/bang/log /opt/bang/data/downloads

[Install]
WantedBy=multi-user.target
