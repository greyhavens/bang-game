# /etc/bang/<node>.env — optional per-node overrides for a bang@<node> unit (e.g.
# /etc/bang/indian_post.env). Only needed when nodes share a host and must not collide.

# each node needs its own management port on a shared host
BANG_SERVER_MGMT_PORT=8082

# JVM heap for this node (read by run-node.sh, not the config bridge)
#BANG_JVM_HEAP=2048m

# back-channel hostname override if the unit shouldn't use `hostname -f`
#BANG_NODE_HOSTNAME=bang2.internal
