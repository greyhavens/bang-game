# /etc/bang/common.env — secrets + host-shared config for all bang@<node> units on this host.
# chmod 0600, chown root:bang. Every BANG_<KEY> maps to config key <key> (lower-cased, _ for . / -)
# via the env bridge in ServerConfig.loadConfig; the key must exist (even blank) in the baked
# conf/server.properties for the override to apply.

# --- database ---
BANG_DB_DEFAULT_URL=jdbc:mysql://db.internal:3306/bang?serverTimezone=UTC
BANG_DB_USERDB_URL=jdbc:mysql://db.internal:3306/ooouser?serverTimezone=UTC
BANG_DB_SITEDB_URL=jdbc:mysql://db.internal:3306/ooouser?serverTimezone=UTC
BANG_DB_DEFAULT_USERNAME=bang
BANG_DB_DEFAULT_PASSWORD=change-me

# --- cluster (required for multi-town; >= 16 chars or the node refuses to start) ---
BANG_SERVER_SECRET=change-me-to-a-long-random-string

# --- transport TLS (Epic 3 Phase 4; generate material with bin/gen-tls-certs) ---
BANG_SERVER_TLS=true
BANG_SERVER_TLS_KEYSTORE=/etc/bang/tls-server.p12
BANG_SERVER_TLS_PASSWORD=change-me-keystore-secret
BANG_SERVER_TLS_TRUSTSTORE=/etc/bang/tls-trust.p12
BANG_SERVER_TLS_TRUSTSTORE_PASSWORD=trustpass

# --- ops ---
BANG_SERVER_LOG_FORMAT=json
# management endpoint: loopback-only by default; give each node a unique port in its <node>.env
# if multiple nodes share this host
BANG_SERVER_MGMT_PORT=8081
