#
# $Id$
#
# Configuration for a Bang! server installation

#
# Various server identification and configuration for each node in our set of
# server clusters.

frontier_town.town_id = frontier_town
frontier_town.server_host = localhost

# indian_post.town_id = indian_post
# indian_post.server_host = bang2.banghowdy.com

# ft_game1.town_id = frontier_town
# ft_game1.server_host = bang3.banghowdy.com

# itp_game1.town_id = indian_post
# itp_game1.server_host = bang4.banghowdy.com

#
# If this server runs as part of a cluster, set this to a strong shared secret (>= 16 chars) that
# authenticates the other town nodes. Blank = standalone. In production inject it via the env var
# BANG_SERVER_SECRET rather than baking it here. NB: the key is left present-but-blank (not
# commented) on purpose — an env override only applies to keys that exist in this baked config.
server_secret =

#
# Transport encryption (Epic 3 Phase 4). When server_tls = true, the entire client<->server TCP
# object stream (login, chat, gameplay) is wrapped in TLS 1.3. Generate the material with
# bin/gen-tls-certs (example paths: etc/test/tls-server.p12 keystore, etc/test/tls-trust.p12
# truststore). The keystore holds the private key and its password is a SECRET — inject it via
# BANG_SERVER_TLS_PASSWORD in production, never ship it. These keys are present-but-blank so env
# vars can override them; TLS stays off until server_tls = true.
server_tls = false
server_tls_keystore =
server_tls_password =
# In cluster mode, peer connections to other nodes' TLS ports also use TLS; point the truststore at
# the pinned cluster cert. The truststore holds only the public cert, so its password is decoupled
# from the keystore secret above (safe to ship) — set it via BANG_SERVER_TLS_TRUSTSTORE_PASSWORD.
server_tls_truststore =
server_tls_truststore_password =

#
# The directory from which the server is run. Used to put log files in the
# proper location and things like that.

server_root = /export/bang

#
# Defines the client authenticator used by the server.

server_auth = com.threerings.bang.server.ooo.OOOAuthenticator

#
# Auto-restart server if code changes (used on dev server)

# auto_restart = false

#
# The default database mapping; all other definitions will inherit from
# this and need only be specified in cases where they differ from the
# defaults

db.default.driver = com.mysql.cj.jdbc.Driver
db.default.url = jdbc:mysql://DBHOST:3306/bang?serverTimezone=UTC
db.default.username = USERNAME
db.default.password = PASSWORD

# These overrides are needed for the OOO user database
db.userdb.url = jdbc:mysql://USERDBHOST:3306/ooouser?serverTimezone=UTC
db.sitedb.url = jdbc:mysql://USERDBHOST:3306/ooouser?serverTimezone=UTC

#
# Bits for the OOO authenticator

oooauth.login_url = /register/register.wm?from=%R
oooauth.access_denied_url = /register/access_denied.wm

#
# Chat whitelist dictionaries

whitelist_dicts = en-us.wordlist
